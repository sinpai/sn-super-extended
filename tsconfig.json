{
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/web/javascripts/*"],
      "@plugin/*": ["src/plugin/*"],
      "@extensions/*": ["src/extensions/*"],
      "@standardnotes/snjs": ["src/compat/snjs.ts"],
      "@standardnotes/models": ["src/compat/models.ts"],
      "@standardnotes/ui-services/src/*": ["src/packages/ui-services/src/*"],
      "@standardnotes/ui-services": ["src/compat/ui-services.ts"],
      "@standardnotes/utils": ["src/compat/utils.ts"],
      "@standardnotes/features": ["src/compat/features.ts"],
      "@standardnotes/i18n": ["src/compat/i18n.ts"],
      "@standardnotes/icons": ["src/packages/icons/src/index.ts"]
    }
  },
  "include": ["src", "dev", "vite.config.ts"]
}
